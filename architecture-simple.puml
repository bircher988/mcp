@startuml architecture-simple
!theme plain
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam ArrowColor #444444
skinparam componentStyle rectangle

actor "User" as user

package "Chat Client (Agent)" as client #LightYellow {
    component "LLM" as llm
}

package "Permission Marketing MCP" as mcp #LightBlue {
    component "Tools\n-------------\nregister_scopes\nrequest_permission\ngrant_permission\ncheck_permission\nrevoke_permission\nlist_permissions\nget_permission_ladder\nget_registered_scopes\nget_audit_trail" as tools
    database "Grant Store\n-------------\nDict[user -> scope -> Grant]\nlevel: int 1-5\nexpires_at: datetime\nconstraints: dict\nrevoked_at: datetime" as db
    collections "Audit Log\n-------------\nREQUEST / GRANT\nCHECK / REVOKE" as audit
}

package "Shopify MCP (streamable HTTP)" as shopifymcp #FFE4B5 {
    component "Tools\n─────────────\nsearch_shop_catalog\nget_product_details\nget_cart\nupdate_cart\nsearch_shop_policies_and_faqs" as shopifytools
    component "Shopify API\n(loutsa-torrefacteur)" as shopifyapi
}

user --> llm : chat message
llm --> tools : permission MCP calls\n(stdio / subprocess)
tools --> db : read / write
tools --> audit : append event

llm --> shopifytools : shopify MCP calls\n(streamable HTTP)
shopifytools --> shopifyapi : HTTPS

@enduml
